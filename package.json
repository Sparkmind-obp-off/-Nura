{
  "name": "nura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=NURA_DB --local --ip 0.0.0.0 --port 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:migrate:local": "wrangler d1 migrations apply NURA_DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply NURA_DB --remote"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "@eslint/js": "^9.35.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@cloudflare/vitest-pool-workers": "0.8.71",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^5.4.20",
    "vitest": "3.2.7",
    "wrangler": "4.35.0"
  }
}
